{
  "name": "@mitaoe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "seed": "node dist/seed.js",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@mitaoe/shared": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "firebase-admin": "14.5.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mitaoe/config": "workspace:*",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
