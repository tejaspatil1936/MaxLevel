{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5"
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/*service-account*.json)",
      "Read(./**/*credentials*.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git add --all:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(firebase deploy:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(terraform apply:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\"", "timeout": 600 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh\"", "timeout": 900 }
        ]
      }
    ]
  }
}
