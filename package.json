{
  "name": "mitaoe-prep",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "scripts/with-emulators.sh turbo run test:int --concurrency=1",
    "prepare": "lefthook install",
    "seed": "scripts/with-emulators.sh pnpm --filter @mitaoe/api run build && pnpm --filter @mitaoe/api run seed"
  },
  "devDependencies": {
    "@mitaoe/config": "workspace:*",
    "eslint": "9.39.5",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
